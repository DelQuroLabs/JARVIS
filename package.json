{
  "name": "jarvis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JARVIS - mobile-first autonomous agent workspace (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/verify.mjs",
    "test:iframe": "node scripts/iframe-check.mjs",
    "test:contrast": "node scripts/contrast.mjs",
    "test:deploy": "node scripts/deploy-check.mjs",
    "test:functional": "node scripts/functional.mjs",
    "test:audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "esbuild": "0.24.0",
    "playwright": "^1.47.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
