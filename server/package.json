    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^10.0.10",
    "openai": "^6.49.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.6.0"
  }
}
