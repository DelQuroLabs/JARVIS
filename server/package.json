{
  "name": "jarvis-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
